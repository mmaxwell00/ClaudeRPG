# Copy to .env and fill in. `.env` is gitignored — never commit real values.
# See ARCHITECTURE.md §12 for the secrets posture.

# ─────────────────────────────────────────────────────────────────────────────
# Docker Model Runner  (ARCHITECTURE.md §6)
#
# REQUIRED — no default. On macOS, Model Runner runs HOST-NATIVE for Metal GPU
# access, so the containerized backend must reach out to the host. Getting this
# wrong is the single most likely setup failure (§6.2), which is why the app
# must fail at startup rather than fall back to a default.
#
#   from inside docker compose:  http://model-runner.docker.internal/engines/v1
#   backend running on host:     http://localhost:12434/engines/v1
# ─────────────────────────────────────────────────────────────────────────────
MODEL_RUNNER_BASE_URL=http://model-runner.docker.internal/engines/v1

# Model identities. Changing EMBEDDING_MODEL invalidates the entire vector
# store and requires a re-embed — see §9.3.
CHAT_MODEL=
EMBEDDING_MODEL=

# ─────────────────────────────────────────────────────────────────────────────
# Database  (ARCHITECTURE.md §8)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_DB=rifts
POSTGRES_USER=rifts
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://rifts:@postgres:5432/rifts

# ─────────────────────────────────────────────────────────────────────────────
# Backend
# ─────────────────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=info

# Optional: pin the RNG seed for reproducible character creation (§2.2).
# Leave blank in normal use; the engine generates and persists a seed per
# character. Set only when reproducing a bug.
RIFTS_SEED=

# ─────────────────────────────────────────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ─────────────────────────────────────────────────────────────────────────────
# Content pipeline — OFFLINE ONLY  (ARCHITECTURE.md §7, §12.1)
#
# These are read by the by-hand pipeline, never by the serving backend.
# Local PDF source directory. Gitignored (§14.3).
# ─────────────────────────────────────────────────────────────────────────────
PDF_SOURCE_DIR=./private/pdfs

# Google Drive as a PDF source is OPTIONAL and currently UNDECIDED — see §12.1.
# If used: read-only scope, one folder, one-directional sync into
# PDF_SOURCE_DIR, and the credential must never be present in the serving path.
# If you are not syncing from Drive, leave these blank and delete the mention
# from README.md rather than leaving an unexplained credential in setup.
GDRIVE_CREDENTIALS_PATH=
GDRIVE_FOLDER_ID=
